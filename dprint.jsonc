{
  "$schema": "https://dprint.dev/schemas/v0.json",
  // global Configuration
  "lineWidth": 100,
  "indentWidth": 2,
  "newLineKind": "lf",
  "useTabs": false,
  // Format only changed files to improve performance
  "incremental": true,
  // https://dprint.dev/plugins/json/config
  "json": {
    "commentLine.forceSpaceAfterSlashes": true,
    "trailingCommas": "never",
    "packageJson.applyConventions": false
  },
  // https://dprint.dev/plugins/markdown/config
  "markdown": {},
  // https://dprint.dev/plugins/pretty_yaml/config
  "yaml": {
    "trailingComma": false,
    "formatComments": true,
    "preferSingleLine": true
  },
  "excludes": ["node_modules", "pnpm-lock.yaml", "schemas"],
  "plugins": [
    "npm:@dprint/json@0.24.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
